# =============================================================================
# .gitignore — Protège les secrets et fichiers locaux
# =============================================================================

# --- Secrets et variables d'environnement ------------------------------------
# On ignore TOUS les fichiers .env...
.env
.env.*
*.env

# ...SAUF le template public de documentation
!.env.example

# --- Clés, certificats et identifiants ---------------------------------------
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa
id_rsa.*
*.token

# --- Fichiers d'identifiants et de secrets -----------------------------------
# Motifs volontairement restreints aux formats de données et aux noms usuels.
# Ne JAMAIS revenir à "*credentials*" / "*secret*" nus : ils capturent aussi le
# code source (un composant "fachkraft-credentials.tsx" a ainsi disparu d'un
# commit). git add -A écarte les fichiers ignorés sans avertir et git status ne
# les affiche pas : la perte est silencieuse et se découvre en CI.
*credential*.json
*credential*.yaml
*credential*.yml
*credential*.txt
*credential*.csv
*secret*.json
*secret*.yaml
*secret*.yml
*secret*.txt
*secret*.csv
client_secret*.json
*service-account*.json
secrets/

# --- Fichiers système --------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# --- Dépendances et builds (pour les projets SaaS) ---------------------------
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/

# --- Logs et temporaires -----------------------------------------------------
*.log
*.tmp
tmp/
.cache/

# --- Worktrees git et clones locaux jetables ---------------------------------
.claude/worktrees/
test-clone/
