{
  "expo": {
    "name": "Len Len",
    "slug": "lenlen-mobile",
    "scheme": "lenlen",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lenlen.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lenlen.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Die Position wird nur beim Pointage (Ankunft/Abfahrt beim Patienten) erfasst, wie in der Einwilligung beschrieben (DSGVO)."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "732584ae-93ab-40b1-83da-dff607fb9dd5"
      }
    },
    "owner": "bigseph"
  }
}