// Prisma Schema – Len Len (SaaS ambulante Pflege)
// Multi-Tenant: jede fachliche Tabelle trägt organizationId.
// Tenant-Isolation wird zusätzlich per PostgreSQL Row-Level Security erzwungen
// (siehe prisma/rls.sql, als Migration eingespielt).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
//  Enums
// ─────────────────────────────────────────────────────────────────────────

enum SubscriptionPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  // Testphase nach der Selbstregistrierung. Voller Funktionsumfang des
  // gebuchten Plans, aber befristet: läuft trial_ends_at ab, ohne dass ein
  // Abo abgeschlossen wurde, suspendiert der Billing-Worker den Tenant.
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum InvoiceStatus {
  PAID
  OPEN
  FAILED
  VOID
}

enum UserRole {
  SUPER_ADMIN
  STRUKTUR_ADMIN
  KOORDINATOR
  HR
  FACHKRAFT
}

enum Locale {
  DE
  EN
  FR
}

enum GeocodingStatus {
  PENDING
  VALID
  INVALID
}

enum ContractType {
  FULL_100
  PART_80
  PART_50
  MINIJOB
  CUSTOM
}

enum Qualification {
  PFLEGEFACHKRAFT
  PFLEGEHILFSKRAFT
  BETREUUNGSKRAFT
  AUSZUBILDENDE
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
}

enum AbsenceType {
  VACATION
  SICK
  TRAINING
  PARENTAL
  UNPAID
  OTHER
}

enum AbsenceStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELED
}

// Herkunftssystem eines HR-Datensatzes. Zusammen mit external_id bildet es den
// Abgleichschlüssel für Importe und Konnektoren (CLAUDE.md, "Intégrations HR
// tierces"): derselbe Satz zweimal importiert aktualisiert, statt zu doppeln.
enum ExternalSource {
  MANUAL
  CSV
  PERSONIO
}

// ─────────────────────────────────────────────────────────────────────────
//  Tenant-Wurzel
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  country              String             @default("DE")
  subscriptionPlan     SubscriptionPlan   @default(BASIC) @map("subscription_plan")
  subscriptionStatus   SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  planLimits           Json               @default("{}") @map("plan_limits")
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  // Beginn der Karenzzeit (Regel 8): gesetzt beim ersten fehlgeschlagenen
  // Zahlungsversuch, geleert sobald wieder bezahlt wurde. Nach Ablauf von
  // BILLING_GRACE_PERIOD_DAYS suspendiert der Billing-Worker den Tenant.
  pastDueSince         DateTime?          @map("past_due_since")
  // Ende der Testphase. Nur bei subscriptionStatus = TRIAL gesetzt; wird beim
  // Abschluss eines Abos geleert, damit der Sweep einen zahlenden Tenant nicht
  // nachträglich suspendiert.
  trialEndsAt          DateTime?          @map("trial_ends_at")
  // Löschung durch den Super-Admin. Bewusst weich: der Tenant verschwindet aus
  // allen Listen und niemand kann sich mehr anmelden, die Daten bleiben aber
  // liegen. Ein Pflegedienst hat Aufbewahrungspflichten (§ 630f BGB), und ein
  // echtes DELETE wäre über die Kaskaden dieser Tabelle nicht rückholbar –
  // Patienten, Besuche und Abrechnung eines ganzen Kunden hingen daran.
  deletedAt            DateTime?          @map("deleted_at")
  // Pflichtangabe: ohne Begründung keine Löschung.
  deletionReason       String?            @map("deletion_reason")
  // Wer gelöscht hat. Bewusst OHNE Fremdschlüssel: der Super-Admin gehört einer
  // anderen Organisation an, und sein Konto darf verschwinden können, ohne die
  // Spur an diesem Datensatz mitzureißen.
  deletedByUserId      String?            @map("deleted_by_user_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  users         User[]
  caregivers    Caregiver[]
  patients      Patient[]
  visits        Visit[]
  vehicles      Vehicle[]
  routes        Route[]
  auditLogs     AuditLog[]
  messages      Message[]
  gpsPositions  GpsPosition[]
  gpsConsents   GpsConsent[]
  invoices      Invoice[]
  contracts     Contract[]
  workSchedules WorkSchedule[]
  absences      Absence[]

  // Das Super-Admin-Panel listet und zählt nach Status, und filtert dabei
  // immer die gelöschten heraus.
  @@index([deletedAt, subscriptionStatus])
  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────
//  Identität & Zugriff
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  role               UserRole
  email              String
  passwordHash       String    @map("password_hash")
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  mfaSecret          String?   @map("mfa_secret")
  // Erzwingt den Passwortwechsel beim nächsten Login. Gesetzt, sobald ein
  // Admin ein temporäres Passwort erzeugt (Anlegen oder Reset eines Kontos).
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  language           Locale    @default(DE)
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caregiver       Caregiver?
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  sentMessages    Message[]
  decidedAbsences Absence[]      @relation("AbsenceDecider")
  acknowledgedIncidents Visit[]  @relation("IncidentAcknowledger")

  // E-Mail eindeutig pro Tenant
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
//  Fachkräfte
// ─────────────────────────────────────────────────────────────────────────

model Caregiver {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String?       @unique @map("user_id") @db.Uuid
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  qualification  Qualification
  // Vertrags-Momentaufnahme: Kopie des AKTUELL gültigen Contract-Satzes.
  // Quelle der Wahrheit ist die Tabelle contracts (versioniert über
  // valid_from/valid_until); diese Felder werden vom HR-Service mitgeführt,
  // damit Planung und VRPTW ohne Join auf den geltenden Vertrag zugreifen.
  contractType   ContractType  @map("contract_type")
  weeklyHours    Decimal       @map("weekly_hours") @db.Decimal(5, 2)
  workDays       Json          @default("[]") @map("work_days") // z.B. ["MON","TUE","WED"]
  maxPatients    Int           @default(0) @map("max_patients")
  isActive       Boolean       @default(true) @map("is_active")
  // Austrittsdatum. Getrennt von updatedAt, das sich bei jeder Änderung
  // verschiebt und daher kein verlässliches Austrittsdatum ist. Der geltende
  // Vertrag wird auf diesen Tag beendet (siehe deactivateCaregiver).
  deactivatedAt  DateTime?     @map("deactivated_at")
  // Zeitpunkt der Anonymisierung (DSGVO Art. 17). Gesetzt = Name und Konto
  // sind unwiderruflich entfernt, der Datensatz selbst bleibt als Anker für
  // Besuche, Touren und Audit-Einträge bestehen. Macht den Vorgang zugleich
  // idempotent: ein zweiter Aufruf findet die Spalte gesetzt und bricht ab,
  // statt einen bereits anonymisierten Satz erneut zu überschreiben.
  anonymizedAt   DateTime?     @map("anonymized_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedPatients Patient[]      @relation("AssignedCaregiver")
  performedVisits  Visit[]        @relation("PerformingCaregiver")
  assignedVisits   Visit[]        @relation("AssignedVisitCaregiver")
  routes           Route[]
  messages         Message[]
  gpsPositions     GpsPosition[]
  gpsConsents      GpsConsent[]
  contracts        Contract[]
  workSchedules    WorkSchedule[]
  absences         Absence[]

  @@index([organizationId])
  @@map("caregivers")
}

// ─────────────────────────────────────────────────────────────────────────
//  HR-Modul (Verträge, Dienstpläne, Abwesenheiten)
// ─────────────────────────────────────────────────────────────────────────
//
// Alle drei Entitäten tragen external_id + external_source + updated_at. Das
// ist die Vorbedingung dafür, dass CSV-Import, Personio-Konnektor und
// DATEV-Webhook (Phase 3) andocken, ohne das Modell umzubauen:
//   - external_id/external_source = Abgleichschlüssel (idempotenter Re-Import)
//   - updated_at                  = inkrementelle Synchronisation
// Siehe CLAUDE.md, Abschnitt "Intégrations HR tierces (Phase 3)".

// Versionierter Vertrag einer Fachkraft. Zu einem Zeitpunkt gilt genau ein
// Vertrag (Überschneidungen weist der Service zurück, siehe hr.rules.ts).
// valid_until = null bedeutet laufend.
model Contract {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  caregiverId    String         @map("caregiver_id") @db.Uuid
  contractType   ContractType   @map("contract_type")
  weeklyHours    Decimal        @map("weekly_hours") @db.Decimal(5, 2)
  workDays       Json           @default("[]") @map("work_days")
  maxPatients    Int            @default(0) @map("max_patients")
  validFrom      DateTime       @map("valid_from") @db.Date
  validUntil     DateTime?      @map("valid_until") @db.Date
  externalId     String?        @map("external_id")
  externalSource ExternalSource @default(MANUAL) @map("external_source")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caregiver    Caregiver    @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  // Abgleichschlüssel. Mehrere NULL-external_id sind in Postgres erlaubt,
  // manuell angelegte Verträge kollidieren also nie miteinander.
  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId])
  @@index([organizationId, caregiverId, validFrom])
  @@index([organizationId, updatedAt])
  @@map("contracts")
}

// Geplante Arbeitszeit an einem Tag (Soll, nicht Ist). Zeiten als Minuten seit
// 00:00 lokaler Zeit: rechenbar (Ist-Stunden, Auslastung) und frei von
// Zeitzonen-Fallen, die ein TIME-Feld mit sich brächte.
model WorkSchedule {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  caregiverId    String         @map("caregiver_id") @db.Uuid
  date           DateTime       @db.Date
  startMinute    Int            @map("start_minute")
  endMinute      Int            @map("end_minute")
  breakMinutes   Int            @default(0) @map("break_minutes")
  note           String?
  externalId     String?        @map("external_id")
  externalSource ExternalSource @default(MANUAL) @map("external_source")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caregiver    Caregiver    @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  // Natürlicher Schlüssel: eine Schicht je Fachkraft, Tag und Startzeit. Ein
  // Re-Import derselben Datei aktualisiert damit auch ohne external_id.
  @@unique([organizationId, caregiverId, date, startMinute])
  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId])
  @@index([organizationId, date])
  @@index([organizationId, updatedAt])
  @@map("work_schedules")
}

// Abwesenheit (Urlaub, Krankheit, Fortbildung ...). Genehmigte Abwesenheiten
// blockieren die Planung; der DATEV-Webhook exportiert genau diese (Phase 3).
model Absence {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  caregiverId     String         @map("caregiver_id") @db.Uuid
  type            AbsenceType
  status          AbsenceStatus  @default(REQUESTED)
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime       @map("end_date") @db.Date
  reason          String?
  decidedByUserId String?        @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?      @map("decided_at")
  externalId      String?        @map("external_id")
  externalSource  ExternalSource @default(MANUAL) @map("external_source")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caregiver    Caregiver    @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  decidedBy    User?        @relation("AbsenceDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalSource, externalId])
  @@index([organizationId])
  @@index([organizationId, caregiverId, startDate])
  @@index([organizationId, status, startDate])
  @@index([organizationId, updatedAt])
  @@map("absences")
}

// ─────────────────────────────────────────────────────────────────────────
//  Chat (Fachkraft <-> Koordination)
// ─────────────────────────────────────────────────────────────────────────

// Eine Konversation pro Fachkraft (caregiverId = Konversationsschlüssel).
// Gegenseite ist das Planungsteam (Koordinator / Struktur-Admin).
model Message {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  caregiverId    String    @map("caregiver_id") @db.Uuid
  senderUserId   String    @map("sender_user_id") @db.Uuid
  body           String
  // Vom Empfänger-Lager gelesen (Fachkraft bzw. Koordination).
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caregiver    Caregiver    @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, caregiverId, createdAt])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────
//  Patienten
// ─────────────────────────────────────────────────────────────────────────

model Patient {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  assignedCaregiverId String?         @map("assigned_caregiver_id") @db.Uuid
  firstName           String          @map("first_name")
  lastName            String          @map("last_name")
  // Sensible Adressdaten werden AES-256-GCM verschlüsselt gespeichert
  rawAddress          String          @map("raw_address")
  normalizedAddress   String?         @map("normalized_address")
  latitude            Decimal?        @db.Decimal(9, 6)
  longitude           Decimal?        @db.Decimal(9, 6)
  geocodingScore      Decimal?        @map("geocoding_score") @db.Decimal(5, 4)
  geocodingStatus     GeocodingStatus @default(PENDING) @map("geocoding_status")
  isActive            Boolean         @default(true) @map("is_active")
  // Löschverlangen eingegangen (DSGVO Art. 17), die Aufbewahrungsfrist läuft
  // aber noch. Bis dahin greift Art. 18: die Daten bleiben bestehen, dürfen
  // aber nicht mehr verarbeitet werden – operativ über isActive=false
  // durchgesetzt. Dieses Feld hält fest, dass die Sperrung auf einem
  // Löschverlangen beruht und nicht auf einem gewöhnlichen Austritt.
  erasureRequestedAt  DateTime?       @map("erasure_requested_at")
  // Gesetzt, sobald nach Ablauf der Frist tatsächlich anonymisiert wurde.
  anonymizedAt        DateTime?       @map("anonymized_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedCaregiver Caregiver?   @relation("AssignedCaregiver", fields: [assignedCaregiverId], references: [id], onDelete: SetNull)
  visits            Visit[]

  @@index([organizationId])
  @@index([organizationId, geocodingStatus])
  @@map("patients")
}

// ─────────────────────────────────────────────────────────────────────────
//  Besuche
// ─────────────────────────────────────────────────────────────────────────

model Visit {
  id                   String      @id @default(uuid()) @db.Uuid
  organizationId       String      @map("organization_id") @db.Uuid
  patientId            String      @map("patient_id") @db.Uuid
  // caregiverId = effektiv durchgeführt (kann Vertretung sein)
  caregiverId          String?     @map("caregiver_id") @db.Uuid
  // assignedCaregiverId = attitré (Stamm-Fachkraft)
  assignedCaregiverId  String?     @map("assigned_caregiver_id") @db.Uuid
  routeId              String?     @map("route_id") @db.Uuid
  scheduledAt          DateTime    @map("scheduled_at")
  status               VisitStatus @default(PLANNED)
  isEmergency          Boolean     @default(false) @map("is_emergency")
  emergencyReason      String?     @map("emergency_reason")
  gpsArrivalAt         DateTime?   @map("gps_arrival_at")
  gpsDepartureAt       DateTime?   @map("gps_departure_at")
  // Position beim Pointage (Mobile-App). Genauigkeit in Metern.
  gpsArrivalLat        Decimal?    @map("gps_arrival_lat") @db.Decimal(9, 6)
  gpsArrivalLng        Decimal?    @map("gps_arrival_lng") @db.Decimal(9, 6)
  gpsArrivalAccuracy   Float?      @map("gps_arrival_accuracy")
  gpsDepartureLat      Decimal?    @map("gps_departure_lat") @db.Decimal(9, 6)
  gpsDepartureLng      Decimal?    @map("gps_departure_lng") @db.Decimal(9, 6)
  gpsDepartureAccuracy Float?      @map("gps_departure_accuracy")
  // Besuchsnotiz der Fachkraft. Bewusst AM BESUCH und nicht in einer eigenen
  // Tabelle: eine Notiz gehört zu genau einem Besuch, hat keine eigene
  // Geschichte und wird nie ohne ihn gelesen. Eine Tabelle mehr hiesse ein
  // Join mehr auf jeder Tagesroute, ohne dass irgendetwas dadurch möglich
  // würde.
  visitNote            String?     @map("visit_note")
  // "Besonderes aufgefallen". Ist die Marke gesetzt, ist die Notiz Pflicht –
  // ein Vorfall ohne Beschreibung wäre für die Koordination wertlos.
  hasIncident          Boolean     @default(false) @map("has_incident")
  // Wann die Notiz zuletzt geschrieben wurde. Trägt die Zwei-Stunden-Frist:
  // ohne diesen Zeitpunkt liesse sich eine Änderung nicht von der ersten
  // Fassung unterscheiden.
  visitNoteWrittenAt   DateTime?   @map("visit_note_written_at")
  // Kenntnisnahme eines gemeldeten Vorfalls durch die Koordination.
  //
  // Ohne diese beiden Felder bliebe die Meldung ein Zustand ohne Ausgang: die
  // Warnung stünde so lange auf dem Bildschirm, wie hasIncident gesetzt ist,
  // und niemand könnte sie schliessen. Eine Warnung, die sich nicht schliessen
  // lässt, wird nach zwei Wochen weggesehen – und dann trägt sie nichts mehr.
  incidentAckAt        DateTime?   @map("incident_ack_at")
  incidentAckByUserId  String?     @map("incident_ack_by_user_id") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient           Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiver         Caregiver?    @relation("PerformingCaregiver", fields: [caregiverId], references: [id], onDelete: SetNull)
  assignedCaregiver Caregiver?    @relation("AssignedVisitCaregiver", fields: [assignedCaregiverId], references: [id], onDelete: SetNull)
  route             Route?        @relation(fields: [routeId], references: [id], onDelete: SetNull)
  incidentAckBy     User?         @relation("IncidentAcknowledger", fields: [incidentAckByUserId], references: [id], onDelete: SetNull)
  gpsPositions      GpsPosition[]

  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([organizationId, status])
  // Verlauf eines Patienten: nur Besuche MIT Notiz, nach Datum. Der Index auf
  // [patientId, scheduledAt] deckt die Sortierung schon ab; dieser hier hält
  // zusätzlich die Vorfälle beisammen, nach denen die Koordination sucht.
  @@index([organizationId, hasIncident, scheduledAt])
  // Die Alarmliste der Koordination fragt genau das ab: offene Vorfälle dieser
  // Organisation. Der Index oben trägt sie nicht gut, weil er nach Datum
  // sortiert und die quittierten mitzieht – und quittiert wird die Mehrzahl.
  @@index([organizationId, incidentAckAt])
  @@map("visits")
}

// ─────────────────────────────────────────────────────────────────────────
//  Fahrzeuge (Leasing)
// ─────────────────────────────────────────────────────────────────────────

model Vehicle {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  label          String
  leasingKmLimit Int       @map("leasing_km_limit")
  leasingKmUsed  Int       @default(0) @map("leasing_km_used")
  leasingEndDate DateTime? @map("leasing_end_date") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routes       Route[]

  @@index([organizationId])
  @@map("vehicles")
}

// ─────────────────────────────────────────────────────────────────────────
//  Touren (VRPTW-Ergebnis)
// ─────────────────────────────────────────────────────────────────────────

model Route {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  caregiverId    String?  @map("caregiver_id") @db.Uuid
  vehicleId      String?  @map("vehicle_id") @db.Uuid
  date           DateTime @db.Date
  visitsOrder    Json     @default("[]") @map("visits_order") // geordnete visitId-Liste
  optimized      Boolean  @default(false)
  vrptwScore     Decimal? @map("vrptw_score") @db.Decimal(5, 2)
  totalKm        Decimal? @map("total_km") @db.Decimal(8, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caregiver    Caregiver?   @relation(fields: [caregiverId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  visits       Visit[]

  @@index([organizationId])
  @@index([organizationId, date])
  @@map("routes")
}

// ─────────────────────────────────────────────────────────────────────────
//  Echtzeit-GPS-Tracking (Phase 2)
// ─────────────────────────────────────────────────────────────────────────

// Positionsverlauf der Fachkräfte während aktiver Besuche. DSGVO: jeder Punkt
// mit Zeitstempel, tenant-isoliert per RLS. distanceToPatientM/geofenceBreach
// werden beim Ingest berechnet (Geofencing 500 m um den geplanten Patienten).
model GpsPosition {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  caregiverId        String   @map("caregiver_id") @db.Uuid
  visitId            String?  @map("visit_id") @db.Uuid
  latitude           Decimal  @db.Decimal(9, 6)
  longitude          Decimal  @db.Decimal(9, 6)
  accuracy           Float?
  // Entfernung zum geplanten Patienten (m) + Geofence-Verletzung (>500 m).
  distanceToPatientM Float?   @map("distance_to_patient_m")
  geofenceBreach     Boolean  @default(false) @map("geofence_breach")
  // recordedAt = Zeitpunkt auf dem Gerät; createdAt = Eingang im Backend.
  recordedAt         DateTime @map("recorded_at")
  createdAt          DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caregiver    Caregiver    @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  visit        Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, caregiverId, recordedAt(sort: Desc)])
  @@index([visitId])
  @@map("gps_positions")
}

// Einwilligung der Fachkraft in die Standorterfassung (DSGVO Art. 6/7, und da
// es sich um Beschäftigtendaten handelt, § 26 BDSG).
//
// Die Tabelle ist BEWUSST append-only: Art. 7 Abs. 1 verlangt, dass der
// Verantwortliche die Einwilligung NACHWEISEN kann. Ein Widerruf überschreibt
// deshalb nichts, er setzt `revokedAt`; eine erneute Einwilligung legt eine
// neue Zeile an. So bleibt für jeden Zeitpunkt belegbar, ob erfasst werden
// durfte – ein UPDATE auf einem einzigen Datensatz könnte das nie.
//
// `policyVersion` ist Teil des Nachweises: eine Einwilligung gilt immer nur
// für den Text, der ihr vorlag. Ändert sich der Text, verliert die alte
// Einwilligung ihre Deckung und muss neu eingeholt werden.
model GpsConsent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  caregiverId    String    @map("caregiver_id") @db.Uuid
  // Version des Einwilligungstextes, dem zugestimmt wurde (z.B. "2026-08-01").
  policyVersion  String    @map("policy_version")
  // Sprache, in der der Text vorlag – Teil des Nachweises: die Fachkraft muss
  // verstanden haben, worin sie einwilligt.
  locale         Locale    @default(DE)
  grantedAt      DateTime  @default(now()) @map("granted_at")
  // null = noch wirksam. Gesetzt = widerrufen (Art. 7 Abs. 3, wirkt nur für
  // die Zukunft; bereits erfasste Punkte bleiben rechtmäßig erhoben).
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caregiver    Caregiver    @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  // Trägt die Prüfung bei JEDEM Positions-Ingest: jüngste Zeile je Fachkraft.
  @@index([organizationId, caregiverId, grantedAt(sort: Desc)])
  @@map("gps_consents")
}

// ─────────────────────────────────────────────────────────────────────────
//  Übersetzungen (i18n DB-Layer, ergänzt next-intl)
// ─────────────────────────────────────────────────────────────────────────

model Translation {
  id     String @id @default(uuid()) @db.Uuid
  locale Locale
  key    String
  value  String

  @@unique([locale, key])
  @@index([locale])
  @@map("translations")
}

// ─────────────────────────────────────────────────────────────────────────
//  Audit-Log (DSGVO: Lesen/Schreiben/Löschen von Patientendaten)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  action         AuditAction
  entityType     String      @map("entity_type")
  entityId       String?     @map("entity_id")
  metadata       Json        @default("{}")
  ipAddress      String?     @map("ip_address")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
//  Billing (Stripe)
// ─────────────────────────────────────────────────────────────────────────

// Rechnungs-Historie eines Tenants. Gespiegelt aus Stripe-Invoice-Events –
// Stripe bleibt die Quelle der Wahrheit, diese Tabelle dient der Anzeige unter
// /billing ohne Stripe-Roundtrip. Beträge in der kleinsten Währungseinheit
// (Cent), wie von Stripe geliefert.
model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  stripeInvoiceId  String        @unique @map("stripe_invoice_id")
  number           String?
  amountDue        Int           @map("amount_due")
  amountPaid       Int           @default(0) @map("amount_paid")
  currency         String        @default("eur")
  status           InvoiceStatus
  hostedInvoiceUrl String?       @map("hosted_invoice_url")
  invoicePdfUrl    String?       @map("invoice_pdf_url")
  issuedAt         DateTime      @map("issued_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, issuedAt])
  @@map("invoices")
}

// Verarbeitete Stripe-Events (Idempotenz). Stripe stellt Events MEHRFACH zu
// (at-least-once); die Event-ID als PK macht das Einfügen zum Gate: schlägt der
// Insert fehl, wurde das Event bereits verarbeitet und wird verworfen.
// System-Tabelle ohne organization_id -> keine RLS (nur System-Pfad schreibt).
model BillingWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("billing_webhook_events")
}
